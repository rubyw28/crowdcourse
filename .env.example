# Copy to .env and fill in. .env is git-ignored.

# Tiger Data service connection string (Console > your service > Connect)
DATABASE_URL=

# Coming in later steps. The web server runs without these; each feature turns on when its key is set.
GEMINI_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_SECRET=
PHOTON_WEBHOOK_SECRET=
# Comma-separated phone numbers texted when a bracelet raises SOS. Needs Photon.
EMERGENCY_CONTACTS=
ELEVENLABS_API_KEY=
# xAI key for Grok Voice (SpaceX track). https://console.x.ai
XAI_API_KEY=
PRESAGE_API_KEY=
# Public https origin Photon can reach, once you have a tunnel. Example: https://abc.ngrok.app
PUBLIC_URL=
