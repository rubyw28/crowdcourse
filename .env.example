# Copy to .env and fill in. .env is git-ignored.
# Only DATABASE_URL is required. Each other feature turns on when its key is set.

# Tiger Data service connection string (Console > your service > Connect)
DATABASE_URL=

# Gemini: the dashboard's spoken line and the agent that answers questions and texts
GEMINI_API_KEY=

# Photon Spectrum: the station's iMessage line (no tunnel needed)
PHOTON_PROJECT_ID=
PHOTON_SECRET=
# Comma-separated numbers that always get SOS, lost, and back-in-range texts,
# on top of anyone who texts the station WATCH
EMERGENCY_CONTACTS=

# Presage SmartSpectra for the responder check-in (also: npm install @smartspectra/node-sdk)
PRESAGE_API_KEY=
